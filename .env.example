# =====================================================================
# SmartTenantAi PM/Tenant/ServicePro Frontend (Vite + React)
# Copy to .env. All vars must be prefixed with VITE_ to be exposed.
# =====================================================================

# --- API endpoints ---------------------------------------------------
# Main backend (Fastify + NestJS).
VITE_API_BASE_URL=http://localhost:3000

# Realtime chat backend (Socket.io / WebSocket).
VITE_CHAT_API_BASE_URL=http://localhost:3001
VITE_CHAT_WS_URL=ws://localhost:3001

# AI chat / RAG service (FastAPI / pms-mcp).
VITE_AI_CHAT_API_URL=http://localhost:8000

# --- Stripe (My Cards / payments) -----------------------------------
# Publishable key ONLY — never put the SECRET key on the frontend.
# https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Maps / geocoding ------------------------------------------------
# https://www.geoapify.com/
VITE_GEOAPIFY_API_KEY=

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=
# --- n8n webhooks (workflow integrations) ----------------------------
VITE_N8N_WEBHOOK_URL=
VITE_N8N_RAG_CHAT_URL=

# --- Firebase Cloud Messaging (push notifications) -------------------
# Public web app config: Firebase Console > Project settings > General >
# Your apps > Web app > SDK setup and configuration. These are safe to ship.
# Push stays dormant until ALL of these (incl. the VAPID key) are set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate "Key pair": Console > Project settings > Cloud Messaging
# > Web configuration > Web Push certificates > Key pair.
VITE_FIREBASE_VAPID_KEY=
