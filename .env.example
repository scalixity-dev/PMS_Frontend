# =====================================================================
# SmartTenantAi PM/Tenant/ServicePro Frontend (Vite + React)
# Copy to .env. All vars must be prefixed with VITE_ to be exposed.
# =====================================================================

# --- API endpoints ---------------------------------------------------
# Main backend (Fastify + NestJS).
VITE_API_BASE_URL=http://localhost:3000

# Realtime chat backend (Socket.io / WebSocket).
VITE_CHAT_API_BASE_URL=http://localhost:3001
VITE_CHAT_WS_URL=ws://localhost:3001

# AI chat / RAG service (FastAPI / pms-mcp).
VITE_AI_CHAT_API_URL=http://localhost:8000

# --- Stripe (My Cards / payments) -----------------------------------
# Publishable key ONLY — never put the SECRET key on the frontend.
# https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Maps / geocoding ------------------------------------------------
# https://www.geoapify.com/
VITE_GEOAPIFY_API_KEY=

# --- n8n webhooks (workflow integrations) ----------------------------
VITE_N8N_WEBHOOK_URL=
VITE_N8N_RAG_CHAT_URL=
